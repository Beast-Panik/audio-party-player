# Laufzeit-Konfiguration (enthaelt Zugangsdaten/Secrets) - wird von install.php erzeugt
config/config.php

# SQLite-Datenbank
data/database.sqlite
data/database.sqlite-shm
data/database.sqlite-wal

# Scan-Zwischenstand
data/scanstate/*.json

# Zwischenstand laufender Chunk-Uploads (siehe src/Uploader.php)
data/uploads/tmp/*
!data/uploads/tmp/.htaccess

# Hochgeladene Tracks (siehe src/Uploader.php) - der Ordner selbst wird
# mitsamt .htaccess ausgeliefert, damit er nicht erst zur Laufzeit angelegt
# werden muss (manche Hoster erlauben restriktiv nur Schreibzugriff
# innerhalb bereits vorhandener Verzeichnisse, siehe README).
data/uploads/library/*
!data/uploads/library/.htaccess

# Extrahierte Cover-Art (wird bei jedem Scan neu erzeugt)
data/covers/*.jpg
data/covers/*.png

# OS/Editor
.DS_Store
Thumbs.db
*.swp

# Lokale Claude-Code-Tooling-Konfiguration (z.B. Dev-Server-Start)
.claude/
